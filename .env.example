PORT=3000
NODE_ENV=development
# 0 = off. Use 1 when behind one reverse proxy (Nginx, Render, etc.)
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aquadevs_afrogo_api_dev

# Comma-separated list of allowed web origins
ALLOWED_ORIGINS=http://localhost:8080

# JWT signing secret (min. 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime (e.g. 5h, 30m, 1d)
JWT_EXPIRES_IN=5h

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=afrogochincha@gmail.com
SMTP_PASSWORD=
MAIL_FROM_NAME=AfroGo

MAX_FILE_SIZE_MB=5
